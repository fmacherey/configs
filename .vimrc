filetype indent plugin on

set rtp+=/opt/homebrew/opt/fzf
set nocompatible
set expandtab
set smarttab
set autoindent
set number
set tabstop=4
set smartindent
set softtabstop=4
set shiftwidth=4
set incsearch
set ignorecase
set smartcase
set hlsearch

set statusline+=%#warningmsg#
set statusline+=%*

syntax on
